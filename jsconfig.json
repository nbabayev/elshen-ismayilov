{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["app/components/*"],
      "@hooks/*": ["app/hooks/*"],
      "@services/*": ["app/services/*"],
      "@utils/*": ["app/utils/*"],
      "@lib/*": ["@lib/*"],
      "@models/*": ["models/*"],
      "@server-services/*": ["services/*"]
    }
  }
}

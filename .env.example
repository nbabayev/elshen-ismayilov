# Database Configuration
DB_HOST=
DB_USER=
DB_NAME=
DB_PORT=
DB_PASS=

# Environment Setup
NODE_ENV=development
ALLOW_LOCAL_DB_IN_PRODUCTION=false
SITE_URL=http://localhost:3000

# Admin authentication (see AUTH.md)
# Generate AUTH_SECRET: openssl rand -base64 48
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# Generate hash: pnpm auth:hash -- "YourStrongPassword"
# The script escapes $ as \$. Do not wrap the hash in quotes.
ADMIN_PASSWORD_HASH=

# Subscription links are signed with this secret (minimum 32 characters).
# Generate one with: openssl rand -base64 48
SUBSCRIPTION_TOKEN_SECRET=

# Protects the article notification recovery cron endpoint.
# Generate one with: openssl rand -base64 48
CRON_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database Configuration
DB_HOST=
DB_USER=
DB_NAME=
DB_PORT=

# Environment Setup
NODE_ENV=development
ALLOW_LOCAL_DB_IN_PRODUCTION=false
SITE_URL=http://localhost:3000

# Subscription links are signed with this secret (minimum 32 characters).
# Generate one with: openssl rand -base64 48
SUBSCRIPTION_TOKEN_SECRET=

# Protects the article notification recovery cron endpoint.
# Generate one with: openssl rand -base64 48
CRON_SECRET=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=